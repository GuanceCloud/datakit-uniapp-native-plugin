/**
 * RUM Module Implementation
 * Corresponds to Android FTRUMModule
 */

import type {
  RUMConfigOptions,
  ActionOptions,
  CreateViewOptions,
  ViewOptions,
  ErrorOptions,
  ResourceOptions,
  ResourceStopOptions,
  ResourceAddOptions,
  ContextValue
} from '../interface.uts';

// Import HarmonyOS FT SDK from local oh_modules package
import { FTSDK } from 'ft_sdk';
import { FTRUMConfig } from 'ft_sdk';
import { FTRUMGlobalManager } from 'ft_sdk';
import { AppState } from 'ft_sdk';
import { ResourceParams } from 'ft_sdk';
import { NetStatusBean } from 'ft_sdk';
import { LogCacheDiscard } from 'ft_sdk';

// Import bridge context
import { getBridgeContext } from './sdk.uts';

/**
 * RUM Configuration
 * Corresponds to Android: setConfig(JSONObject data)
 */
export function setConfig(options: RUMConfigOptions): void {
  (async () => {
    try {
      const rumAppId = options.harmonyAppId || options.androidAppId || options.iOSAppId;
      const rumConfig = new FTRUMConfig().setRumAppId(rumAppId);
      
      if (options.samplerate !== undefined) {
        rumConfig.setSamplingRate(options.samplerate);
      }
      if (options.sessionOnErrorSampleRate !== undefined) {
        rumConfig.setSessionErrorSampleRate(options.sessionOnErrorSampleRate);
      }
      if (options.enableNativeUserAction !== undefined) {
        rumConfig.setEnableTraceUserAction(options.enableNativeUserAction);
      }
      if (options.enableNativeUserView !== undefined) {
        rumConfig.setEnableTraceUserView(options.enableNativeUserView);
      }
      if (options.enableNativeUserResource !== undefined) {
        rumConfig.setEnableTraceUserResource(options.enableNativeUserResource);
      }
      if (options.enableResourceHostIP !== undefined) {
        rumConfig.setEnableResourceHostIP(options.enableResourceHostIP);
      }
      if (options.enableTrackNativeCrash !== undefined) {
        rumConfig.setEnableTrackAppCrash(options.enableTrackNativeCrash);
      }
      if (options.enableTrackNativeAppANR !== undefined) {
        rumConfig.setEnableTrackAppANR(options.enableTrackNativeAppANR);
      }
      if (options.enableTrackNativeFreeze !== undefined) {
        const freezeDuration = options.nativeFreezeDurationMs || 1000;
        rumConfig.setEnableTrackAppUIBlock(options.enableTrackNativeFreeze, freezeDuration);
      }
      if (options.enableTraceWebView !== undefined) {
        rumConfig.setEnableTraceWebView(options.enableTraceWebView);
      }
      if (options.globalContext) {
        const keys = Object.keys(options.globalContext);
        for (let i = 0; i < keys.length; i++) {
          const key = keys[i];
          rumConfig.addGlobalContext(key, toObject(options.globalContext[key]));
        }
      }
      
      await FTSDK.installRUMConfig(rumConfig);
      console.log('[GC-UniPlugin-HarmonyOS] rumSetConfig completed successfully');
    } catch (error) {
      console.error('[GC-UniPlugin-HarmonyOS] rumSetConfig failed:', error);
    }
  })();
}

/**
 * Start Action
 * Corresponds to Android: startAction(JSONObject data)
 */
export function startAction(options: ActionOptions): void {
  try {
    const rumManager = FTRUMGlobalManager.getInstance();
    const property = mergeBridgeContext(options.property);
    rumManager.startActionFull(options.actionName, options.actionType, false, property);
    console.log('[GC-UniPlugin-HarmonyOS] rumStartAction completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin-HarmonyOS] rumStartAction failed:', error);
  }
}

/**
 * Add Action
 * Corresponds to Android: addAction(JSONObject data)
 */
export function addAction(options: ActionOptions): void {
  try {
    const rumManager = FTRUMGlobalManager.getInstance();
    const property = mergeBridgeContext(options.property);
    rumManager.startActionFull(options.actionName, options.actionType, false, property);
    console.log('[GC-UniPlugin-HarmonyOS] rumAddAction completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin-HarmonyOS] rumAddAction failed:', error);
  }
}

/**
 * Create View
 * Corresponds to Android: onCreateView(JSONObject data)
 */
export function onCreateView(options: CreateViewOptions): void {
  try {
    const rumManager = FTRUMGlobalManager.getInstance();
    rumManager.onCreateView(options.viewName, options.loadTime);
    console.log('[GC-UniPlugin-HarmonyOS] rumOnCreateView completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin-HarmonyOS] rumOnCreateView failed:', error);
  }
}

/**
 * Start View
 * Corresponds to Android: startView(JSONObject data)
 */
export function startView(options: ViewOptions): void {
  (async () => {
    try {
      const rumManager = FTRUMGlobalManager.getInstance();
      const property = mergeBridgeContext(options.property);
      await rumManager.startView(options.viewName || '', property);
      console.log('[GC-UniPlugin-HarmonyOS] rumStartView completed successfully');
    } catch (error) {
      console.error('[GC-UniPlugin-HarmonyOS] rumStartView failed:', error);
    }
  })();
}

/**
 * Stop View
 * Corresponds to Android: stopView(JSONObject data)
 */
export function stopView(options?: ViewOptions): void {
  (async () => {
    try {
      const rumManager = FTRUMGlobalManager.getInstance();
      if (options && options.property) {
        const property = mergeBridgeContext(options.property);
        await rumManager.stopView(property);
      } else {
        const emptyProperty: Record<string, object> = {};
        await rumManager.stopView(emptyProperty);
      }
      console.log('[GC-UniPlugin-HarmonyOS] rumStopView completed successfully');
    } catch (error) {
      console.error('[GC-UniPlugin-HarmonyOS] rumStopView failed:', error);
    }
  })();
}

/**
 * Add Error
 * Corresponds to Android: addError(JSONObject data)
 */
export function addError(options: ErrorOptions): void {
  try {
    const rumManager = FTRUMGlobalManager.getInstance();
    // Convert state string to AppState enum
    let appState: AppState = AppState.UNKNOWN;
    if (options.state) {
      if (options.state === 'run') {
        appState = AppState.RUN;
      } else if (options.state === 'background') {
        appState = AppState.BACKGROUND;
      }
    }
    const property = mergeBridgeContext(options.property);
    rumManager.addError(options.stack, options.message, 'uniapp_crash', appState, property);
    console.log('[GC-UniPlugin-HarmonyOS] rumAddError completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin-HarmonyOS] rumAddError failed:', error);
  }
}

/**
 * Start Resource
 * Corresponds to Android: startResource(JSONObject data)
 */
export function startResource(options: ResourceOptions): void {
  try {
    const rumManager = FTRUMGlobalManager.getInstance();
    rumManager.startResource(options.key);
    console.log('[GC-UniPlugin-HarmonyOS] rumStartResource completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin-HarmonyOS] rumStartResource failed:', error);
  }
}

/**
 * Stop Resource
 * Corresponds to Android: stopResource(JSONObject data)
 */
export function stopResource(options: ResourceStopOptions): void {
  try {
    const rumManager = FTRUMGlobalManager.getInstance();
    // Extract statusCode and contentLength from property if available
    let statusCode = 200;
    let contentLength = 0;
    if (options.property) {
      if (options.property['statusCode']) {
        statusCode = Number(options.property['statusCode']) || 200;
      }
      if (options.property['contentLength']) {
        contentLength = Number(options.property['contentLength']) || 0;
      }
    }
    rumManager.stopResource(options.key, statusCode, contentLength);
    console.log('[GC-UniPlugin-HarmonyOS] rumStopResource completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin-HarmonyOS] rumStopResource failed:', error);
  }
}

/**
 * Add Resource
 * Corresponds to Android: addResource(JSONObject data)
 */
export function addResource(options: ResourceAddOptions): void {
  try {
    const rumManager = FTRUMGlobalManager.getInstance();
    const params = new ResourceParams();
    params.url = options.content.url;
    if (options.content.httpMethod) {
      params.resourceMethod = options.content.httpMethod;
    }
    if (options.content.requestHeader) {
      params.requestHeader = normalizeHeaderValue(options.content.requestHeader);
    }
    if (options.content.responseHeader) {
      params.responseHeader = normalizeHeaderValue(options.content.responseHeader);
    }
    if (options.content.responseBody) {
      params.responseBody = options.content.responseBody;
    }
    params.resourceStatus = options.content.resourceStatus || 0;
    
    const netStatusBean = new NetStatusBean();
    rumManager.addResource(options.key, params, netStatusBean);
    console.log('[GC-UniPlugin-HarmonyOS] rumAddResource completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin-HarmonyOS] rumAddResource failed:', error);
  }
}

/**
 * Merge bridge context into properties
 */
function mergeBridgeContext(property?: Record<string, ContextValue>): Record<string, object> {
  const result: Record<string, object> = {};
  if (property) {
    const keys = Object.keys(property);
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      result[key] = toObject(property[key]);
    }
  }
  const bridgeCtx = getBridgeContext();
  
  bridgeCtx.forEach((value, key) => {
    result[key] = toObject(value);
  });
  
  return result;
}

function toObject(value: ContextValue): object {
  return new Object(value);
}

function normalizeHeaderValue(value: unknown): string {
  if (typeof value === 'string') {
    return value;
  }
  if (value === null || value === undefined) {
    return '';
  }
  try {
    return JSON.stringify(value);
  } catch (error) {
    return String(value);
  }
}
