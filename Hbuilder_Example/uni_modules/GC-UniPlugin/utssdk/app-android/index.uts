import {
	GCLoggerConfig,
	GCLoggerLogParams,
	GCMobileConfig,
	GCRUMActionParams,
	GCRUMAddResourceParams,
	GCRUMCreateViewParams,
	GCRUMErrorParams,
	GCRUMResourceParams,
	GCRUMStopViewParams,
	GCRUMConfig,
	GCRUMUserDataParams,
	GCRUMViewParams,
	GCTraceHeaderParams,
	GCTraceConfig,
} from '../interface.uts'
import {
	appendBridgeContextState,
	cloneParams,
	mergePropertyForParams,
	normalizeLoggerConfigParams,
	normalizeLoggingParams,
	normalizeRumConfigParams,
	normalizeSdkConfigParams,
	normalizeTraceConfigParams
} from '../bridge.uts'
import {
	prepareAddResourceParams
} from './utils/FTUniPluginUtils.uts'
import {
	GCUniPluginNative
} from 'gc.uniplugin.android'

let gcUTSDebugEnabled = false

function updateUTSDebugEnabled(params: GCMobileConfig | null) {
	gcUTSDebugEnabled = params != null && params.debug == true
}

function debugLog(message: string) {
	if (gcUTSDebugEnabled) {
		console.log('[GC-UniPlugin][Android][UTS] ' + message)
	}
}

function stringifyParams(params: any | null): string {
	if (params == null) {
		return '{}'
	}
	return JSON.stringify(params) ?? '{}'
}

function debugLogConfig(methodName: string, json: string) {
	debugLog(methodName + ' params=' + json)
}

function parseJSONResult(result: string | null): any | null {
	if (result == null || result.length === 0) {
		return null
	}
	return JSON.parse(result)
}

function createBindRUMUserDataParams(userId: string, userName?: string | null, userEmail?: string | null, extra?: any | null): GCRUMUserDataParams {
	return {
		userId,
		userName: userName == null ? null : userName,
		userEmail: userEmail == null ? null : userEmail,
		extra: extra == null ? null : extra
	}
}

function bindRUMUserCompat(userId: string, userName?: string | null, userEmail?: string | null, extra?: any | null) {
	const json = stringifyParams(createBindRUMUserDataParams(userId, userName, userEmail, extra))
	debugLog('bindRUMUserData called, jsonLength=' + json.length.toString())
	GCUniPluginNative.bindRUMUserData(json)
	debugLog('bindRUMUserData returned')
}

export class mobileAgent {
	static sdkConfig(params: GCMobileConfig) {
		updateUTSDebugEnabled(params)
		const json = stringifyParams(normalizeSdkConfigParams(params))
		debugLogConfig('sdkConfig', json)
		GCUniPluginNative.sdkConfig(json)
		debugLog('sdkConfig returned')
	}

	static bindRUMUserData(params: GCRUMUserDataParams) {
		if (params == null || params.userId == null) {
			return
		}
		bindRUMUserCompat(params.userId, params.userName, params.userEmail, params.extra)
	}

	static unbindRUMUserData() {
		debugLog('unbindRUMUserData called')
		GCUniPluginNative.unbindRUMUserData()
		debugLog('unbindRUMUserData returned')
	}

	static appendGlobalContext(params: any | null) {
		const json = stringifyParams(params)
		debugLog('appendGlobalContext called, jsonLength=' + json.length.toString())
		GCUniPluginNative.appendGlobalContext(json)
		debugLog('appendGlobalContext returned')
	}

	static appendRUMGlobalContext(params: any | null) {
		const json = stringifyParams(params)
		debugLog('appendRUMGlobalContext called, jsonLength=' + json.length.toString())
		GCUniPluginNative.appendRUMGlobalContext(json)
		debugLog('appendRUMGlobalContext returned')
	}

	static appendLogGlobalContext(params: any | null) {
		const json = stringifyParams(params)
		debugLog('appendLogGlobalContext called, jsonLength=' + json.length.toString())
		GCUniPluginNative.appendLogGlobalContext(json)
		debugLog('appendLogGlobalContext returned')
	}

	static appendBridgeContext(params: any | null) {
		appendBridgeContextState(params)
		const json = stringifyParams(params)
		debugLog('appendBridgeContext called, jsonLength=' + json.length.toString())
		GCUniPluginNative.appendBridgeContext(json)
		debugLog('appendBridgeContext returned')
	}

	static flushSyncData() {
		debugLog('flushSyncData called')
		GCUniPluginNative.flushSyncData()
		debugLog('flushSyncData returned')
	}

	static clearAllData() {
		debugLog('clearAllData called')
		GCUniPluginNative.clearAllData()
		debugLog('clearAllData returned')
	}

	static shutDown() {
		debugLog('shutDown called')
		GCUniPluginNative.shutDown()
		debugLog('shutDown returned')
	}

	static manuallySetApplicationStart() {
		debugLog('manuallySetApplicationStart called')
		GCUniPluginNative.manuallySetApplicationStart()
		debugLog('manuallySetApplicationStart returned')
	}
}

export class rum {
	static setConfig(params: GCRUMConfig) {
		const json = stringifyParams(normalizeRumConfigParams(params))
		debugLogConfig('setRumConfig', json)
		GCUniPluginNative.setRumConfig(json)
		debugLog('setRumConfig returned')
	}

	static startAction(params: GCRUMActionParams) {
		GCUniPluginNative.startAction(stringifyParams(mergePropertyForParams(params)))
	}

	static addAction(params: GCRUMActionParams) {
		GCUniPluginNative.addAction(stringifyParams(mergePropertyForParams(params)))
	}

	static onCreateView(params: GCRUMCreateViewParams) {
		GCUniPluginNative.onCreateView(stringifyParams(cloneParams(params)))
	}

	static startView(params: GCRUMViewParams) {
		GCUniPluginNative.startView(stringifyParams(mergePropertyForParams(params)))
	}

	static stopView(params: GCRUMStopViewParams | null) {
		GCUniPluginNative.stopView(stringifyParams(cloneParams(params)))
	}

	static addError(params: GCRUMErrorParams) {
		GCUniPluginNative.addError(stringifyParams(mergePropertyForParams(params)))
	}

	static startResource(params: GCRUMResourceParams) {
		GCUniPluginNative.startResource(stringifyParams(mergePropertyForParams(params)))
	}

	static stopResource(params: GCRUMResourceParams) {
		GCUniPluginNative.stopResource(stringifyParams(cloneParams(params)))
	}

	static addResource(params: GCRUMAddResourceParams) {
		const result = prepareAddResourceParams(params)
		GCUniPluginNative.addResource(stringifyParams(result))
	}
}

export class logger {
	static setConfig(params: GCLoggerConfig) {
		const json = stringifyParams(normalizeLoggerConfigParams(params))
		debugLogConfig('setLoggerConfig', json)
		GCUniPluginNative.setLoggerConfig(json)
		debugLog('setLoggerConfig returned')
	}

	static logging(params: GCLoggerLogParams) {
		const json = stringifyParams(normalizeLoggingParams(params))
		debugLog('logging called, jsonLength=' + json.length.toString())
		GCUniPluginNative.logging(json)
		debugLog('logging returned')
	}
}

export class tracer {
	static setConfig(params: GCTraceConfig) {
		const json = stringifyParams(normalizeTraceConfigParams(params))
		debugLogConfig('setTraceConfig', json)
		GCUniPluginNative.setTraceConfig(json)
		debugLog('setTraceConfig returned')
	}

	static getTraceHeader(params: GCTraceHeaderParams): any | null {
		const json = stringifyParams(params)
		debugLog('getTraceHeader called, jsonLength=' + json.length.toString())
		const result = GCUniPluginNative.getTraceHeader(json)
		debugLog('getTraceHeader returned, hasResult=' + (result == null ? 'false' : 'true'))
		return parseJSONResult(result)
	}
}

