/**
 * GC-UniPlugin Main Entry File
 * Exports all module methods
 */

// Import interface definitions
import type {
  SDKConfigOptions,
  BindRUMUserDataOptions,
  GlobalContextOptions,
  RUMConfigOptions,
  ActionOptions,
  CreateViewOptions,
  ViewOptions,
  ErrorOptions,
  ResourceOptions,
  ResourceStopOptions,
  ResourceAddOptions,
  LoggerConfigOptions,
  LoggingOptions,
  TracerConfigOptions,
  TraceHeaderOptions
} from '../interface.uts';

// Import module implementations
import * as SDKModule from './sdk.uts';
import * as RUMModule from './rum.uts';
import * as LoggerModule from './logger.uts';
import * as TracerModule from './tracer.uts';

// ==================== SDK Base Module Exports ====================

/**
 * SDK Configuration
 */
export function sdkConfig(options: SDKConfigOptions): void {
  SDKModule.sdkConfig(options);
}

/**
 * Bind RUM User Data
 */
export function bindRUMUserData(options: BindRUMUserDataOptions): void {
  SDKModule.bindRUMUserData(options);
}

/**
 * Unbind RUM User Data
 */
export function unbindRUMUserData(): void {
  SDKModule.unbindRUMUserData();
}

/**
 * Flush Sync Data Immediately
 */
export function flushSyncData(): void {
  SDKModule.flushSyncData();
}

/**
 * Append Global Context
 */
export function appendGlobalContext(options: GlobalContextOptions): void {
  SDKModule.appendGlobalContext(options);
}

/**
 * Append Log Global Context
 */
export function appendLogGlobalContext(options: GlobalContextOptions): void {
  SDKModule.appendLogGlobalContext(options);
}

/**
 * Append RUM Global Context
 */
export function appendRUMGlobalContext(options: GlobalContextOptions): void {
  SDKModule.appendRUMGlobalContext(options);
}

/**
 * Shutdown SDK
 */
export function shutDown(): void {
  SDKModule.shutDown();
}

/**
 * Clear All Data
 */
export function clearAllData(): void {
  SDKModule.clearAllData();
}

/**
 * Manually Set Application Start Time
 */
export function manuallySetApplicationStart(): void {
  SDKModule.manuallySetApplicationStart();
}

/**
 * Append Bridge Context
 */
export function appendBridgeContext(options: GlobalContextOptions): void {
  SDKModule.appendBridgeContext(options);
}

// ==================== RUM Module Exports ====================

/**
 * RUM Configuration
 */
export function rumSetConfig(options: RUMConfigOptions): void {
  RUMModule.setConfig(options);
}

/**
 * Start Action
 */
export function rumStartAction(options: ActionOptions): void {
  RUMModule.startAction(options);
}

/**
 * Add Action
 */
export function rumAddAction(options: ActionOptions): void {
  RUMModule.addAction(options);
}

/**
 * Create View
 */
export function rumOnCreateView(options: CreateViewOptions): void {
  RUMModule.onCreateView(options);
}

/**
 * Start View
 */
export function rumStartView(options: ViewOptions): void {
  RUMModule.startView(options);
}

/**
 * Stop View
 */
export function rumStopView(options?: ViewOptions): void {
  RUMModule.stopView(options);
}

/**
 * Add Error
 */
export function rumAddError(options: ErrorOptions): void {
  RUMModule.addError(options);
}

/**
 * Start Resource
 */
export function rumStartResource(options: ResourceOptions): void {
  RUMModule.startResource(options);
}

/**
 * Stop Resource
 */
export function rumStopResource(options: ResourceStopOptions): void {
  RUMModule.stopResource(options);
}

/**
 * Add Resource
 */
export function rumAddResource(options: ResourceAddOptions): void {
  RUMModule.addResource(options);
}

// ==================== Logger Module Exports ====================

/**
 * Logger Configuration
 */
export function loggerSetConfig(options: LoggerConfigOptions): void {
  LoggerModule.setConfig(options);
}

/**
 * Logging
 */
export function loggerLogging(options: LoggingOptions): void {
  LoggerModule.logging(options);
}

// ==================== Tracer Module Exports ====================

/**
 * Tracer Configuration
 */
export function tracerSetConfig(options: TracerConfigOptions): void {
  TracerModule.setConfig(options);
}

/**
 * Get Trace Header
 */
export function tracerGetTraceHeader(options: TraceHeaderOptions): Record<string, string> | null {
  return TracerModule.getTraceHeader(options);
}

// The common JS helpers introduced by feature-uts use class-based exports.
// Keep the original Harmony function exports above for compatibility, and
// expose equivalent classes so all three native platforms share one JS API.
export class mobileAgent {
  static sdkConfig(params: SDKConfigOptions) {
    sdkConfig(params)
  }

  static bindRUMUserData(params: BindRUMUserDataOptions) {
    bindRUMUserData(params)
  }

  static unbindRUMUserData() {
    unbindRUMUserData()
  }

  static appendGlobalContext(params: GlobalContextOptions) {
    appendGlobalContext(params)
  }

  static appendRUMGlobalContext(params: GlobalContextOptions) {
    appendRUMGlobalContext(params)
  }

  static appendLogGlobalContext(params: GlobalContextOptions) {
    appendLogGlobalContext(params)
  }

  static appendBridgeContext(params: GlobalContextOptions) {
    appendBridgeContext(params)
  }

  static flushSyncData() {
    flushSyncData()
  }

  static clearAllData() {
    clearAllData()
  }

  static shutDown() {
    shutDown()
  }

  static manuallySetApplicationStart() {
    manuallySetApplicationStart()
  }
}

export class rum {
  static setConfig(params: RUMConfigOptions) {
    rumSetConfig(params)
  }

  static startAction(params: ActionOptions) {
    rumStartAction(params)
  }

  static addAction(params: ActionOptions) {
    rumAddAction(params)
  }

  static onCreateView(params: CreateViewOptions) {
    rumOnCreateView(params)
  }

  static startView(params: ViewOptions) {
    rumStartView(params)
  }

  static stopView(params?: ViewOptions) {
    rumStopView(params)
  }

  static addError(params: ErrorOptions) {
    rumAddError(params)
  }

  static startResource(params: ResourceOptions) {
    rumStartResource(params)
  }

  static stopResource(params: ResourceStopOptions) {
    rumStopResource(params)
  }

  static addResource(params: ResourceAddOptions) {
    rumAddResource(params)
  }
}

export class logger {
  static setConfig(params: LoggerConfigOptions) {
    loggerSetConfig(params)
  }

  static logging(params: LoggingOptions) {
    loggerLogging(params)
  }
}

export class tracer {
  static setConfig(params: TracerConfigOptions) {
    tracerSetConfig(params)
  }

  static getTraceHeader(params: TraceHeaderOptions): Record<string, string> | null {
    return tracerGetTraceHeader(params)
  }
}

export class GCEnv {
  static readonly PROD: string = 'prod'
  static readonly GRAY: string = 'gray'
  static readonly PRE: string = 'pre'
  static readonly COMMON: string = 'common'
  static readonly LOCAL: string = 'local'
}

export class GCDiscardStrategy {
  static readonly DISCARD: string = 'discard'
  static readonly DISCARD_OLDEST: string = 'discardOldest'
}

export class GCTraceType {
  static readonly DDTRACE: string = 'ddTrace'
  static readonly ZIPKIN_MULTI_HEADER: string = 'zipkinMultiHeader'
  static readonly ZIPKIN_SINGLE_HEADER: string = 'zipkinSingleHeader'
  static readonly TRACEPARENT: string = 'traceparent'
  static readonly SKYWALKING: string = 'skywalking'
  static readonly JAEGER: string = 'jaeger'
}

export class GCMonitorFrequency {
  static readonly NORMAL: string = 'normal'
  static readonly FREQUENT: string = 'frequent'
  static readonly RARE: string = 'rare'
}

export class GCLogStatus {
  static readonly INFO: string = 'info'
  static readonly DEBUG: string = 'debug'
  static readonly WARNING: string = 'warning'
  static readonly ERROR: string = 'error'
  static readonly CRITICAL: string = 'critical'
  static readonly OK: string = 'ok'
}

export class GCErrorMonitorType {
  static readonly BATTERY: string = 'battery'
  static readonly MEMORY: string = 'memory'
  static readonly CPU: string = 'cpu'
  static readonly ALL: string = 'all'
}

export class GCDeviceMonitorType {
  static readonly BATTERY: string = 'battery'
  static readonly MEMORY: string = 'memory'
  static readonly CPU: string = 'cpu'
  static readonly FPS: string = 'fps'
  static readonly ALL: string = 'all'
}
