/**
 * Tracer Module Implementation
 * Corresponds to Android FTTracerModule
 */

import type {
  TracerConfigOptions,
  TraceHeaderOptions
} from '../interface.uts';

// Import HarmonyOS FT SDK from local oh_modules package
import { FTSDK } from '@guancecloud/ft_sdk';
import { FTTraceConfig } from '@guancecloud/ft_sdk';
import { FTTraceManager } from '@guancecloud/ft_sdk';
import { TraceType } from '@guancecloud/ft_sdk';

/**
 * Tracer Configuration
 * Corresponds to Android: setConfig(JSONObject data)
 */
export function setConfig(options: TracerConfigOptions): void {
  try {
    const traceConfig = new FTTraceConfig();
    
    if (options.sampleRate !== undefined) {
      traceConfig.setSamplingRate(options.sampleRate);
    }
    
    if (options.traceType) {
      let traceTypeEnum: TraceType;
      switch (options.traceType) {
        case "ddTrace":
          traceTypeEnum = TraceType.DDTRACE;
          break;
        case "zipkinMultiHeader":
          traceTypeEnum = TraceType.ZIPKIN_MULTI_HEADER;
          break;
        case "zipkinSingleHeader":
          traceTypeEnum = TraceType.ZIPKIN_SINGLE_HEADER;
          break;
        case "traceparent":
          traceTypeEnum = TraceType.TRACEPARENT;
          break;
        case "skywalking":
          traceTypeEnum = TraceType.SKYWALKING;
          break;
        case "jaeger":
          traceTypeEnum = TraceType.JAEGER;
          break;
        default:
          traceTypeEnum = TraceType.DDTRACE;
      }
      traceConfig.setTraceType(traceTypeEnum);
    }
    
    if (options.enableLinkRUMData !== undefined) {
      traceConfig.setEnableLinkRUMData(options.enableLinkRUMData);
    }
    
    if (options.enableNativeAutoTrace !== undefined) {
      traceConfig.setEnableAutoTrace(options.enableNativeAutoTrace);
    }
    
    FTSDK.installTraceConfig(traceConfig);
    console.log('[GC-UniPlugin] tracerSetConfig completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin] tracerSetConfig failed:', error);
  }
}

/**
 * Get Trace Header
 * Corresponds to Android: getTraceHeader(JSONObject data)
 */
export function getTraceHeader(options: TraceHeaderOptions): Record<string, string> | null {
  try {
    const traceManager = FTTraceManager.getInstance();
    const headers = traceManager.getTraceHeader(options.key, options.url);
    console.log('[GC-UniPlugin] tracerGetTraceHeader completed successfully');
    return headers;
  } catch (error) {
    console.error('[GC-UniPlugin] tracerGetTraceHeader failed:', error);
    return null;
  }
}
