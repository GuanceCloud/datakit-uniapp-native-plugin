/**
 * Logger Module Implementation
 * Corresponds to Android FTLogModule
 */

import type {
  LoggerConfigOptions,
  LoggingOptions,
  ContextValue
} from '../interface.uts';

// Import HarmonyOS FT SDK from local oh_modules package
import { FTSDK } from 'ft_sdk';
import { FTLoggerConfig } from 'ft_sdk';
import { FTLogger } from 'ft_sdk';
import { Status } from 'ft_sdk';
import { LogCacheDiscard } from 'ft_sdk';

// Import bridge context
import { getBridgeContext } from './sdk.uts';

/**
 * Logger Configuration
 * Corresponds to Android: setConfig(JSONObject data)
 */
export function setConfig(options: LoggerConfigOptions): void {
  try {
    const logConfig = new FTLoggerConfig();
    
    if (options.enableCustomLog !== undefined) {
      logConfig.setEnableCustomLog(options.enableCustomLog);
    }
    if (options.samplerate !== undefined) {
      logConfig.setSamplingRate(options.samplerate);
    }
    if (options.discardStrategy) {
      if (options.discardStrategy === "discardOldest") {
        logConfig.setLogCacheDiscardStrategy(LogCacheDiscard.DISCARD_OLDEST);
      } else if (options.discardStrategy === "discard") {
        logConfig.setLogCacheDiscardStrategy(LogCacheDiscard.DISCARD);
      }
    }
    if (options.logLevelFilters && options.logLevelFilters.length > 0) {
      const normalizedFilters: string[] = [];
      for (let i = 0; i < options.logLevelFilters.length; i++) {
        const rawFilter = String(options.logLevelFilters[i] || '');
        const normalizedName = normalizeStatusName(rawFilter.toLowerCase());
        const statusObj = Status.fromName(normalizedName);
        if (statusObj) {
          normalizedFilters.push(statusObj.name);
        }
      }
      if (normalizedFilters.length > 0) {
        logConfig.setLogLevelFilters(normalizedFilters);
      }
    }
    if (options.enableLinkRumData !== undefined) {
      logConfig.setEnableLinkRumData(options.enableLinkRumData);
    }
    if (options.globalContext) {
      const keys = Object.keys(options.globalContext);
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i];
        logConfig.addGlobalContext(key, String(options.globalContext[key]));
      }
    }
    if (options.logCacheLimitCount !== undefined) {
      logConfig.setLogCacheLimitCount(options.logCacheLimitCount);
    }
    
    FTSDK.installLogConfig(logConfig);
    console.log('[GC-UniPlugin] loggerSetConfig completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin] loggerSetConfig failed:', error);
  }
}

/**
 * Logging
 * Corresponds to Android: logging(JSONObject data)
 */
export function logging(options: LoggingOptions): void {
  try {
    const propertyMap = mergeBridgeContext(options.property);
    // Convert status string to Status enum
    let logStatus: Status = Status.INFO;
    const statusStr = options.status?.toLowerCase() || '';
    const normalizedName = normalizeStatusName(statusStr);
    const statusObj = Status.fromName(normalizedName);
    if (statusObj) {
      logStatus = statusObj;
    }
    FTLogger.logBackground(options.content, logStatus, propertyMap);
    console.log('[GC-UniPlugin] loggerLogging completed successfully');
  } catch (error) {
    console.error('[GC-UniPlugin] loggerLogging failed:', error);
  }
}

/**
 * Merge bridge context into properties
 */
function mergeBridgeContext(property?: Record<string, ContextValue>): Map<string, object> {
  const map = new Map<string, object>();
  
  // First add passed properties
  if (property) {
    const keys = Object.keys(property);
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      map.set(key, toObject(property[key]));
    }
  }
  
  // Then add bridge context
  const bridgeCtx = getBridgeContext();
  bridgeCtx.forEach((value, key) => {
    map.set(key, toObject(value));
  });
  
  return map;
}

function toObject(value: ContextValue): object {
  return new Object(value);
}

function normalizeStatusName(status: string): string {
  if (status === 'ok') {
    return 'info';
  }
  if (status === 'critical') {
    return 'fatal';
  }
  if (status === 'warning') {
    return 'warn';
  }
  return status;
}
