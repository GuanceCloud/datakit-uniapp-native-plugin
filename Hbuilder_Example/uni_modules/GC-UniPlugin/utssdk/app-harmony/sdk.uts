/**
 * Append Bridge Context
 * Corresponds to Android: appendBridgeContext(JSONObject context)
 */
export function appendBridgeContext(options: GlobalContextOptions): void {
  try {
    if (options) {
      const keys = Object.keys(options);
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i];
        bridgeContext.set(key, options[key]);
      }
    }
    console.log('[GC-UniPlugin] appendBridgeContext called with:', JSON.stringify(options));
  } catch (error) {
    console.error('[GC-UniPlugin] appendBridgeContext failed:', error);
  }
}

/**
 * Get Bridge Context (for use by other modules)
 */
export function getBridgeContext(): Map<string, ContextValue> {
  return bridgeContext;
}

/**
 * Utility function: Convert value to object for ArkTS API signatures.
 */
/**
 * Utility function: Convert context to Map<string, string>
 * FTSDK's appendGlobalContext methods require Map<string, string>
 */
function convertToMapString(obj: GlobalContextOptions): Map<string, string> {
  const map = new Map<string, string>();
  const keys = Object.keys(obj);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    map.set(key, String(obj[key]));
  }
  return map;
}

function convertToMapObject(obj: GlobalContextOptions): Map<string, object> {
  const map = new Map<string, object>();
  const keys = Object.keys(obj);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    map.set(key, new Object(obj[key]));
  }
  return map;
}
