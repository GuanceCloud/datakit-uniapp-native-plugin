/**
 * SDK Base Module Implementation
 * Corresponds to Android FTSDKUniModule
 */

import type {
  SDKConfigOptions,
  BindRUMUserDataOptions,
  GlobalContextOptions,
  ContextValue
} from '../interface.uts';

// Import HarmonyOS FT SDK from local oh_modules package
import { FTSDK } from '@guancecloud/ft_sdk';
import { FTSDKConfig } from '@guancecloud/ft_sdk';
import { UserData } from '@guancecloud/ft_sdk';
import { Context } from '@kit.AbilityKit';

// Bridge context (corresponds to Android bridgeContext)
let bridgeContext: Map<string, ContextValue> = new Map();

// Initialize bridge context
bridgeContext.set("sdk_bridge_info", "uniapp:0.2.7");

/**
 * Get Context (needs to be implemented when actually used)
 * In UTS plugin, may need to get Context through other means
 * Note: In uni-app, Context might be available through global variables or passed from JS side
 */
function getContext(): Context | undefined {
  // In uni-app UTS plugin, Context might be available through global variables
  // For now, return undefined and let SDK handle it
  // The SDK's install method accepts optional Context parameter
  return undefined;
}

/**
 * SDK Configuration
 * Corresponds to Android: sdkConfig(JSONObject data)
 */
export function sdkConfig(options: SDKConfigOptions): void {
    try {
      // 1. Parse configuration parameters
      const datakitUrl = options.datakitUrl || options.serverUrl;
      const datawayUrl = options.datawayUrl;
      const cliToken = options.clientToken;
      const debug = options.debug;
      const env = options.env;
      const serviceName = options.service;
      const globalContext = options.globalContext;

      // 2. Build FTSDKConfig
      const sdkConfig = datakitUrl
        ? FTSDKConfig.builder(datakitUrl)
        : FTSDKConfig.builder(datawayUrl, cliToken);

      if (debug !== undefined) {
        sdkConfig.setDebug(debug);
      }
      if (env) {
        sdkConfig.setEnv(env);
      }
      if (serviceName) {
        sdkConfig.setServiceName(serviceName);
      }
      if (globalContext) {
        const keys = Object.keys(globalContext);
        for (let i = 0; i < keys.length; i++) {
          const key = keys[i];
          sdkConfig.addGlobalContext(key, new Object(globalContext[key]));
        }
      }

      // 3. Install SDK
      FTSDK.install(sdkConfig, getContext());
      console.log('[GC-UniPlugin] sdkConfig completed successfully');
    } catch (error) {
      console.error('[GC-UniPlugin] sdkConfig failed:', error);
    }

}

/**
 * Bind RUM User Data
 * Corresponds to Android: bindRUMUserData(JSONObject data)
 */
export function bindRUMUserData(options: BindRUMUserDataOptions): void {
    try {
      const userData = new UserData();
      if (options.userId) {
        userData.setId(options.userId);
      }
      if (options.userName) {
        userData.setName(options.userName);
      }
      if (options.userEmail) {
        userData.setEmail(options.userEmail);
      }
      if (options.extra) {
        const extraKeys = Object.keys(options.extra);
        for (let i = 0; i < extraKeys.length; i++) {
          const key = extraKeys[i];
          userData.addExt(key, options.extra[key]);
        }
      }
       FTSDK.bindRumUserData(userData);

      console.log('[GC-UniPlugin] bindRUMUserData completed successfully');
    } catch (error) {
      console.error('[GC-UniPlugin] bindRUMUserData failed:', error);
    }
}

/**
 * Unbind RUM User Data
 * Corresponds to Android: unbindRUMUserData()
 */
export function unbindRUMUserData(): void {
    try {
      FTSDK.unbindRumUserData();
      console.log('[GC-UniPlugin] unbindRUMUserData completed successfully');
    } catch (error) {
      console.error('[GC-UniPlugin] unbindRUMUserData failed:', error);
    }
}

