}

/**
 * Append Global Context
 * Corresponds to Android: appendGlobalContext(JSONObject extra)
 */
export function appendGlobalContext(options: GlobalContextOptions): void {
  try {
    if (options) {
      const contextMap = convertToMapString(options);
      FTSDK.appendGlobalContext(contextMap);
      console.log('[GC-UniPlugin] appendGlobalContext completed successfully');
    }
  } catch (error) {
    console.error('[GC-UniPlugin] appendGlobalContext failed:', error);
  }
}

