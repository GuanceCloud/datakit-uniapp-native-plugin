# HBuilderX injects both the compiled H5 bundle and UTS static modules here.
# They are application build inputs, not host source code.
# Keep the empty target directory visible in a fresh clone; all injected files
# inside it remain local build input.
HBuilder-uniPluginDemo/entry/src/main/resources/resfile/apps/HBuilder/**
!HBuilder-uniPluginDemo/entry/src/main/resources/resfile/apps/HBuilder/.gitkeep
HBuilder-uniPluginDemo/entry/src/main/ets/uni_modules/index.generated.ets
HBuilder-uniPluginDemo/uni_modules/

# DevEco / OHPM generated state
HBuilder-uniPluginDemo/oh_modules/
HBuilder-uniPluginDemo/.hvigor/
HBuilder-uniPluginDemo/entry/build/
HBuilder-uniPluginDemo/oh-package-lock.json5
*.hap
*.app
*.har
*.hsp
*.hvp
oh_modules/
.hvigor/
.idea/
build/

# Local signing material and user-specific runtime values
*.p12
*.p7b
*.cer
*.pfx
*.keystore
*.mobileprovision

# The repository-wide rule ignores Markdown build artifacts; this is source documentation.
!README.md
